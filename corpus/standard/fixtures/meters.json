        "scope": "session",
        "max_uses": 2,
        "max_duration_ms": 500,
        "any_args": true,
        "allow_any_args_metered": true
      }
    },
    "eu.pay": { "meters": ["eur_day"] },
    "search.web": { "meters": ["calls_minute"] }
  }
