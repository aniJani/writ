  | .notStarted => "The session has not started."
  | .alreadyStarted => "The session is already running."
  | .sessionEnded => "This session has ended."
  | .staleSeq => "That action arrived out of order and was ignored."
  | .timeDecreasing => "That action carried an earlier time than the last one and was ignored."
  | .stateVersionMismatch => "The session changed while this action was in flight, so it was not applied."
  | .policyDigestMismatch => "This session was started under different rules than the ones now loaded."
  | .duplicateCall => "That action reused the label of an earlier, different request."
  | .unknownCall => "That action refers to a request that does not exist."
  | .staleRequest => "That request is out of date because things changed since it was made."
  | .unknownApprover => "That approver is not registered for this session."
  | .callAwaiting => "That request is still waiting for approval."
  | .callAuthorized => "That request is approved and has not run yet."
  | .callDispatched => "That request is already running."
  | .callUnknown => "It is not known whether that request ran."
  | .callEnded => "That request has already finished."
  | .alreadyReconciled => "That request's outcome has already been recorded."
  | .retryNotAllowed => "That request cannot be retried because it may already have run."
  | .notEscalated => "There is nothing to clear."
  | .approverChanged => "That approver is already registered with different details."
  | .approverNotEligible => "That approver is not allowed to approve this."
  | .alreadyApproved => "You already approved this."
  | .digestMismatch => "The request no longer matches what was reviewed."
  | .costMismatch => "The cost no longer matches what was reviewed."
  | .editNotAllowed => "This request cannot be edited during approval."
  | .duplicateGrant => "A standing approval with that label already exists."
  | .unknownGrant => "There is no such standing approval to revoke."
  | .grantNotAllowed => "This cannot be approved in advance under the current rules."
  | .attemptOrder => "The attempt count for this request was out of order."
  | .idempotencyKeyMismatch => "The duplicate-protection key for this request changed between attempts."
  | .attemptLimit => "This request has used all of its attempts."
  | .turnState => "That action is not valid at this point in the conversation."
  | .killed => "This session was stopped."
  | .escalated => "Actions are paused until someone reviews the earlier problems."
  | .unknownTool => "That tool is not part of the rules for this agent."
  | .notExposed => "That tool is not available to this agent."
  | .proposalLimit => "The agent reached its limit of requests for this turn."
  | .stepLimit => "The agent reached its limit of steps for this turn."
  | .permissionMissing => "This needs a permission that has not been granted."
  | .guardFalse => "A required condition for this action is not met right now."
  | .costMissing => "This action needs a cost and none was provided."
  | .currencyMismatch => "The cost is in a different currency than the budget uses."
  | .costAbovePerCall => "This costs more than is allowed for a single action."
  | .meterExceeded => "This would go over a spending or usage limit."
  | .previouslyRejected => "You rejected this earlier in the conversation."
  | .approvalBudget => "The agent has asked for too many approvals this turn."
  | .approvalExpired => "The approval request timed out."
  | .authorizationExpired => "Your approval expired before the action ran."
  | .grantInvalid => "The standing approval for this is no longer valid."
  | .ledgerConflict => "Usage records changed elsewhere, so this session was stopped."
  | .sessionProposalLimit => "The agent reached its limit of requests for this session."
  | .sessionApprovalBudget => "The agent reached its limit of approval requests for this session."

end Writ
