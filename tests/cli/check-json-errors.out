{"ok":false,"errors":[{"code":"unknown_meter","action":"a","message":"it uses meter \"nope\", which is not defined"},{"code":"zero_quorum","action":"a","message":"a consent clause has a quorum of 0"},{"code":"unknown_role","action":"a","message":"a consent clause names role \"boss\", which is not an approver role"},{"code":"retry_needs_idempotent","action":"b","message":"retry_after_unknown needs the action to be idempotent"},{"code":"zero_max_attempts","action":"b","message":"max_attempts is 0"},{"code":"zero_failure_limit","message":"max_consecutive_failures is 0"}],"warnings":[{"code":"no_approval_ttl","message":"some actions can need approval but no approval_ttl_ms is set, so requests never expire"}],"policy_digest":"sha256:28fbe13a8aa40cb513841604f2ee50320f0983feb9c4361a028df340ba6ad99e"}
