    "eur_day": { "currency": "EUR", "cap": 1, "scope": "principal", "window_ms": 1000 },
    "calls_minute": { "unit": "calls", "cap": 1, "scope": "principal", "window_ms": 100 }
  },
  "actions": {
    "shop.buy": {
      "consent": "per_call",
      "consent_if_cost_over": { "amount": "2", "currency": "USD" },
